#!/usr/bin/env bash
# coord-validate — validate an agent output JSON file against its schema.
#
# Usage:
#   bin/coord-validate <agent-name> <path/to/output.json>
#   bin/coord-validate <agent-name> -          # read JSON from stdin
#
# Examples:
#   bin/coord-validate worker .coord/tasks/TASK-042.json
#   cat output.json | bin/coord-validate reviewer -
#
# Behavior:
#   - Exits 0 if the JSON validates against schemas/<agent>-output.schema.json
#   - Exits 1 if validation fails (with the validator's error printed)
#   - Exits 2 on usage errors (missing args, schema not found, file not found)
#
# Validator selection (first available is used):
#   1. ajv (npm i -g ajv-cli)  — fastest, best diagnostics
#   2. check-jsonschema (pip install check-jsonschema)
#   3. python -m jsonschema    — fallback if Python `jsonschema` package is installed
#
# If none are available, the script prints install instructions and exits 2.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SCHEMAS_DIR="$REPO_ROOT/schemas"

usage() {
  cat <<EOF
Usage: $(basename "$0") <agent-name> <path/to/output.json | ->

Validate an agent output JSON file against schemas/<agent-name>-output.schema.json.
Pass '-' to read JSON from stdin.

Available agents:
$(ls "$SCHEMAS_DIR"/*-output.schema.json 2>/dev/null | xargs -I{} basename {} -output.schema.json | sed 's/^/  /')
EOF
}

if [ "$#" -ne 2 ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 2
fi

AGENT="$1"
INPUT="$2"
SCHEMA="$SCHEMAS_DIR/${AGENT}-output.schema.json"

if [ ! -f "$SCHEMA" ]; then
  echo "error: schema not found for agent '$AGENT' at $SCHEMA" >&2
  echo "" >&2
  usage >&2
  exit 2
fi

# Resolve input source
if [ "$INPUT" = "-" ]; then
  TMPFILE="$(mktemp -t coord-validate.XXXXXX.json)"
  trap 'rm -f "$TMPFILE"' EXIT
  cat > "$TMPFILE"
  INPUT_PATH="$TMPFILE"
else
  if [ ! -f "$INPUT" ]; then
    echo "error: input file not found: $INPUT" >&2
    exit 2
  fi
  INPUT_PATH="$INPUT"
fi

# Pick a validator
if command -v ajv >/dev/null 2>&1; then
  exec ajv validate -s "$SCHEMA" -d "$INPUT_PATH" --spec=draft2020 --strict=false
fi

if command -v check-jsonschema >/dev/null 2>&1; then
  exec check-jsonschema --schemafile "$SCHEMA" "$INPUT_PATH"
fi

if command -v python3 >/dev/null 2>&1; then
  if python3 -c "import jsonschema" 2>/dev/null; then
    python3 - "$SCHEMA" "$INPUT_PATH" <<'PY'
import json, sys
from jsonschema import Draft202012Validator
schema = json.load(open(sys.argv[1]))
data   = json.load(open(sys.argv[2]))
errs = sorted(Draft202012Validator(schema).iter_errors(data), key=lambda e: e.path)
if not errs:
    print("OK")
    sys.exit(0)
for e in errs:
    path = "/".join(map(str, e.absolute_path)) or "<root>"
    print(f"FAIL  {path}: {e.message}", file=sys.stderr)
sys.exit(1)
PY
    exit $?
  fi
fi

cat >&2 <<EOF
error: no JSON Schema validator found on PATH.
Install one of:
  npm install -g ajv-cli           # recommended
  pip install check-jsonschema     # alternative
  pip install jsonschema           # fallback (used via python -m)
EOF
exit 2
